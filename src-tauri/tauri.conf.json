{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawX",
  "version": "1.0.0",
  "identifier": "com.valuecell.clawx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClawX",
        "url": "/",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "spotlight",
        "title": "Spotlight",
        "url": "/spotlight",
        "width": 680,
        "height": 480,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-window",
        "spotlight-window"
      ]
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/openclaw.tar.gz": "openclaw.tar.gz",
      "../build/openclaw.version": "openclaw.version"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://oss.intelli-spectrum.com/latest/tauri-update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMzk4NTkyNzcxMzM5MDYKUldRR09STjNrb1U1VENwbThheW1jSVRrWm5PbVgxY2dnaW0zUU1Xa2dkbDVkYXdUN0dHK292UkMK"
    }
  }
}
